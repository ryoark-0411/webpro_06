<!Doctype html>
<html>
<head>
  <meta charset="utf-8">
  <title><%= data.name %></title>
</head>
<body>
  <h2><%= data.name %>の詳細</h2>
  <table>
    <tr><th>項目</th><th>データ</th></tr>
    <tr><td>ID</td><td><%= data.id %></td></tr>
    <tr><td>選手名</td><td><%= data.name %></td></tr>
    <tr><td>ポジション</td><td><%= data.position %></td></tr>
    <tr><td>背番号</td><td><%= data.number %></td></tr>
    <tr><td>所属チーム</td><td><%= data.team %></td></tr>
    <tr><td>リーグ</td><td><%= data.league %></td></tr>
  </table>
  <a href="/soccer">選手一覧に戻る</a>
</body>
</html>